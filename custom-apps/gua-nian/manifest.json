{
  "sdkVersion": "1.0",
  "id": "gua.nian",
  "name": "挂念",
  "version": "0.3.0",
  "author": "Float",
  "description": "让角色过上自己的一天：每天生成TA的状态与日程，在日程里挑出几个「想起你」的时刻，结合最近的聊天氛围做动机复核，再预约成离线主动消息——浏览器关着也会收到TA的推送。「记录」页可以回看每一天：TA什么时候起念、为什么、发没发出去、你回了没有。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "chat.read",
    "ai.generate",
    "calendar.read",
    "calendar.write",
    "push.wake",
    "ui.toast"
  ],
  "resources": {
    "presets": [
      "presets.json"
    ]
  }
}
