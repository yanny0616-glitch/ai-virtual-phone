{
  "sdkVersion": "1.0",
  "id": "gua.nian",
  "name": "挂念",
  "version": "0.1.5",
  "author": "Float",
  "description": "让角色过上自己的一天：每天生成TA的状态与日程，在日程里挑出几个「想起你」的时刻，经过动机复核后预约成离线主动消息——浏览器关着也会收到TA的推送。面板可随时预览TA此刻会说什么，每条主动消息为什么发、为什么没发都有诊断可查。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "ai.generate",
    "calendar.read",
    "calendar.write",
    "push.wake",
    "ui.toast"
  ],
  "resources": {
    "presets": [
      "presets.json"
    ]
  }
}
