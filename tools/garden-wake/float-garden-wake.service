[Unit]
Description=Float Garden wake configuration and inbox
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/node /root/vibe-coding/float/garden-wake-adapter/service.mjs
WorkingDirectory=/root/vibe-coding/float/garden-wake-adapter
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/float-garden-wake
TimeoutStopSec=20
[Install]
WantedBy=multi-user.target
